{
  "manifest_version": 3,
  "name": "focus: allowed subreddits",
  "description": "Blocks Reddit except the subreddits you allow with the focus CLI, while focus is on.",
  "version": "0.0.0",
  "minimum_chrome_version": "121",
  "key": "",
  "incognito": "spanning",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["alarms", "declarativeNetRequest", "nativeMessaging", "storage", "tabs", "webNavigation"],
  "host_permissions": ["*://*.reddit.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/comments/*", "*://*.reddit.com/gallery/*", "*://*.reddit.com/r/*/comments/*"],
      "js": ["comments.js"],
      "run_at": "document_idle"
    }
  ]
}
