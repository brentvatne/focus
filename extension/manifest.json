{
  "manifest_version": 3,
  "name": "focus",
  "description": "While focus is on, blocks the feeds of YouTube and X, limits Instagram to messages and Reddit to the subreddits you allow, as set with the focus CLI.",
  "version": "0.0.0",
  "minimum_chrome_version": "121",
  "key": "",
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "nativeMessaging",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.reddit.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/comments/*",
        "*://*.reddit.com/gallery/*",
        "*://*.reddit.com/r/*/comments/*"
      ],
      "js": [
        "comments.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "youtube.css"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start"
    }
  ]
}
